@using Drive.ReportingUI.Web.Data.Models
@using Drive.ReportingUI.Web.Helpers
@model IEnumerable<BusinessEvent>

<h2>Business Events</h2>
<table id="businessEventsTable" class="table table-striped table-hover table-bordered w-100">
    <thead>
        <tr>
            <th></th>
            <th>Event Id</th>
            <th>Event Timestamp</th>
            <th>Entity Type</th>
            <th>Event Type</th>
            <th>Version</th>
            <th>Actor Id</th>
            <th>Actor Type</th>
            <th>Correlation Id</th>
            <th>Entity Data </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="dt-control"></td>
                <td>
                    <a href="#"
                        class="event-metadata-link"
                        data-event-id="@item.EventId">
                        @item.EventId
                    </a>
                </td>
                <td>@item.EventTimestamp.ToServerLocalDisplay()</td>
                <td>@item.EntityType</td>
                <td>@item.EventType</td>
                <td>@item.SchemaVersion</td>
                <td>@item.ActorId</td>
                <td>@item.ActorType</td>
                <td>@item.CorrelationId</td>
                <td class="entity-data">
                    <pre>@item.EntityData</pre>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="metadataModal" tabindex="-1" aria-labelledby="metadataModalLabel" aria-hidden="true">
    <div id="metadataModalDialog" class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="metadataModalLabel">Business Event Metadata</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body metadata-modal-body">
                <table id="metadataTable" class="display table table-striped w-100">
                    <thead>
                        <tr>
                            <th>Entity Id</th>
                            <th>Entity Type</th>
                            <th>Metadata Key</th>
                            <th>Metadata Value</th>
                            <th>Data Type</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>